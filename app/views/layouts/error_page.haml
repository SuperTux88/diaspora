!!!
%html
  %head
    %title= page_title yield(:page_title)

    %meta{charset:  "utf-8"}
    %link{rel: "shortcut icon", href: image_path("favicon.png")}
    %link{rel: "apple-touch-icon", href: image_path("apple-touch-icon.png")}

    = stylesheet_link_tag "color_themes/original/desktop", media: "all"
    = stylesheet_link_tag :nerdpol_error_pages, media: "all"

    = yield(:head)

  %body{class: "error-#{local_assigns[:code]}", id: "error_#{local_assigns[:code]}"}
    = render partial: "errors/header"

    = yield

    = render partial: "layouts/footer"
